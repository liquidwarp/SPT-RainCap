<Project>
    <PropertyGroup>
        <Authors>Trinagan</Authors>
        <ModName>RainCap</ModName>
        <ModGuid>com.trinagan.raincap</ModGuid>
        <VersionPrefix>2.0.0</VersionPrefix>
        <ForkMarker>lqw</ForkMarker>
        <ForkRevision>1</ForkRevision>
        <VersionSuffix>$(ForkMarker)-$(ForkRevision)</VersionSuffix>
        <Version>$(VersionPrefix)-$(VersionSuffix)</Version>
        <ClientSPTVersion>4.1.6</ClientSPTVersion>
        <Product>$(ModName)</Product>
        <ReleaseDir>$(MSBuildThisFileDirectory)releases\$(Authors)-$(ModName)-$(Version)</ReleaseDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>None</DebugType>
        <GenerateDependencyFile>false</GenerateDependencyFile>
    </PropertyGroup>
</Project>
